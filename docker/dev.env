# Settings for `pnpm dev`, pointing at docker/compose.dev.yaml. Development only. There are no
# credentials here: the dev containers use trust auth on loopback, and `pnpm dev` generates the
# auth secret into .dev-secrets/ (gitignored). Paths are relative to each app's directory.
LAKKA_LOG_LEVEL=debug
LAKKA_DATABASE_HOST=127.0.0.1
LAKKA_DATABASE_PORT=55432
LAKKA_CACHE_HOST=127.0.0.1
LAKKA_CACHE_PORT=56379
LAKKA_API_HOST=127.0.0.1
LAKKA_WORKER_HEALTH_HOST=127.0.0.1
LAKKA_SECRETS_DIR=../../.dev-secrets
LAKKA_PUBLIC_URL=http://localhost:5173
# stdio MCP servers run inside the api under `pnpm dev`, with its network and its secrets: there
# is no sandbox service here (ADR 0118). The api warns at startup; a production image refuses it.
LAKKA_TOOL_HOST_URL=in-process
