{
  "name": "lakka",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted AI control plane for small teams",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "LAKKA_SECRETS_DIR=.dev-secrets node apps/api/src/cli/init-secrets.ts --dev && docker compose -f docker/compose.dev.yaml up -d --wait && pnpm --parallel --filter './apps/*' --filter '!@lakka/site' dev",
    "setup-code": "pnpm --reporter=silent --filter @lakka/api run setup-code",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:copy": "scripts/check-copy.sh apps/web/src docs/index.md docs/guide apps/site/package.json apps/site/.vitepress/config.ts apps/site/.vitepress/theme apps/site/public",
    "check:dco": "scripts/check-dco.sh",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:out-of-process": "vitest run --config vitest.out-of-process.config.ts",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "test:e2e": "playwright test",
    "stories": "pnpm --filter @lakka/web storybook",
    "demo:seed": "node test/demo/seed.ts",
    "demo:capture": "node test/demo/capture.ts",
    "test:stories": "pnpm --filter @lakka/web build-storybook && playwright test --config playwright.stories.config.ts",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "test:compat:python": "scripts/compat-python.sh",
    "test:compat:apps": "scripts/compat-apps.sh",
    "site:dev": "pnpm --filter @lakka/site dev",
    "site:build": "pnpm --filter @lakka/site build",
    "site:preview": "pnpm --filter @lakka/site preview",
    "site:check": "scripts/site-check.sh",
    "ci:local": "scripts/ci-local.sh",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667",
    "scan": "scripts/scan.sh",
    "test:bundle": "scripts/bundle-smoke.sh",
    "test:upgrade": "scripts/upgrade-test.sh",
    "release:bundle": "node scripts/release-bundle.ts",
    "db:generate": "pnpm --filter @lakka/db exec drizzle-kit generate",
    "db:migrate": "node --env-file=docker/dev.env apps/api/src/cli/migrate.ts",
    "models:fetch": "node scripts/fetch-models.ts",
    "catalogue:update": "node scripts/update-catalogue.ts",
    "catalogue:keygen": "node scripts/catalogue-keygen.ts",
    "catalogue:sign": "node scripts/catalogue-sign.ts",
    "classifier:eval": "node apps/api/src/cli/classifier-eval.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lakka/core": "workspace:*",
    "@lakka/db": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "openai": "7.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "pnpm@12.6.0"
}
